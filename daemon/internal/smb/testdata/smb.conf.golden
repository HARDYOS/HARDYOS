# HardyOS file sharing (SMB). Written by hardyd-priv from the shared
# folders and Control Panel > File Services: changes here are replaced.
[global]
	server role = member server
	security = ads
	workgroup = HOME
	realm = HOME.EXAMPLE.NET
	netbios name = HARDYOS
	server string = HardyOS
	password server = 192.168.1.20 192.168.1.21 *
	kerberos method = secrets and keytab
	dedicated keytab file = /var/lib/hardyos-files/samba/krb5.keytab
	winbind use default domain = no
	winbind refresh tickets = yes
	winbind offline logon = no
	winbind enum users = no
	winbind enum groups = no
	idmap config * : backend = tdb
	idmap config * : range = 3000-7999
	idmap config HOME : backend = rid
	idmap config HOME : range = 100000-999999
	template shell = /usr/sbin/nologin
	template homedir = /mnt/tank/homes/home.%U
	disable netbios = yes
	smb ports = 445
	server min protocol = SMB2_10
	server signing = default
	multicast dns register = no
	load printers = no
	printing = bsd
	printcap name = /dev/null
	disable spoolss = yes
	unix extensions = no
	map to guest = Bad User
	guest account = nobody
	fruit:metadata = stream
	fruit:model = MacSamba
	fruit:posix_rename = yes
	fruit:veto_appledouble = no
	fruit:nfs_aces = no
	fruit:wipe_intentionally_left_blank_rfork = yes
	fruit:delete_empty_adfiles = yes
	private dir = /var/lib/hardyos-files/samba/private
	state directory = /var/lib/hardyos-files/samba/state
	cache directory = /var/lib/hardyos-files/samba/cache
	lock directory = /var/lib/hardyos-files/samba/lock
	logging = file
	log file = /var/log/samba/log.%m
	max log size = 5000
	log level = 1

[homes]
	comment = Home folder
	browseable = no
	read only = no
	valid users = %S
	guest ok = no
	vfs objects = catia fruit streams_xattr acl_xattr
	inherit acls = yes
	map acl inherit = yes
	create mask = 0600
	directory mask = 0700

[Backups]
	path = /mnt/tank/shares/backups
	vfs objects = catia fruit streams_xattr shadow_copy2 acl_xattr
	read only = yes
	valid users = "@HOME\Domain Admins", "@HOME\Domain Users"
	write list = "@HOME\Domain Admins", "@HOME\Domain Users"
	guest ok = no
	access based share enum = yes
	inherit acls = yes
	map acl inherit = yes
	hide files = /.recycle/.zfs/
	veto files = /.hardyos*/
	shadow:mountpoint = /mnt/tank/shares/backups
	shadow:snapdir = .zfs/snapshot
	shadow:snapprefix = ^hardyos-auto-\(hourly\|daily\|weekly\|monthly\)$
	shadow:delimiter = _
	shadow:format = _%Y-%m-%d-%H%M
	shadow:localtime = no
	shadow:sort = desc
	fruit:time machine = yes
	fruit:time machine max size = 512000M

[Kids' Films & TV (2024) v.2_x-y]
	comment = 50 off quotes back slash
	path = /mnt/tank/shares/kids-films-tv-2024-v-2-x-y
	vfs objects = catia fruit streams_xattr acl_xattr recycle
	read only = yes
	valid users = "@HOME\Domain Admins", "HOME\alice", "@HOME\Family"
	read list = "@HOME\Family"
	write list = "@HOME\Domain Admins", "HOME\alice"
	invalid users = "HOME\bob"
	guest ok = no
	access based share enum = yes
	inherit acls = yes
	map acl inherit = yes
	hide files = /.recycle/.zfs/
	veto files = /.hardyos*/
	recycle:repository = .recycle/home.%U
	recycle:keeptree = yes
	recycle:versions = yes
	recycle:touch = yes
	recycle:directory_mode = 0700
	recycle:subdir_mode = 0700
	recycle:exclude_dir = .recycle

[Media]
	comment = Movies, TV shows, music and photos
	path = /mnt/tank/shares/media
	vfs objects = catia fruit streams_xattr shadow_copy2 acl_xattr recycle
	read only = yes
	valid users = "@HOME\Domain Admins", "@HOME\Domain Users", "nobody"
	read list = "@HOME\Domain Users", "nobody"
	write list = "@HOME\Domain Admins"
	guest ok = yes
	access based share enum = yes
	inherit acls = yes
	map acl inherit = yes
	hide files = /.recycle/.zfs/
	veto files = /.hardyos*/
	recycle:repository = .recycle/home.%U
	recycle:keeptree = yes
	recycle:versions = yes
	recycle:touch = yes
	recycle:directory_mode = 0700
	recycle:subdir_mode = 0700
	recycle:exclude_dir = .recycle
	shadow:mountpoint = /mnt/tank/shares/media
	shadow:snapdir = .zfs/snapshot
	shadow:snapprefix = ^hardyos-auto-\(hourly\|daily\|weekly\|monthly\)$
	shadow:delimiter = _
	shadow:format = _%Y-%m-%d-%H%M
	shadow:localtime = no
	shadow:sort = desc
