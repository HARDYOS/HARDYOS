[Unit]
Description=HardyOS privileged helper
Documentation=https://github.com/HARDYOS/HARDYOS
After=local-fs.target zfs-mount.service
# Before networking: a settings restore applied at start-up writes the network
# files that networking then brings up.
Before=hardyd.service networking.service

[Service]
# Ready once the socket is up, after any rollback of a failed update has
# finished, so hardyd never opens a database that is about to be rolled back.
Type=notify
NotifyAccess=main
TimeoutStartSec=10min
# Root user, hardyd group: the socket directory /run/hardyos becomes root:hardyd 0750.
Group=hardyd
ExecStart=/usr/bin/hardyd-priv -socket /run/hardyos/priv.sock -allow-user hardyd
RuntimeDirectory=hardyos
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=2s
# Root is needed for zfs, disks and network changes; limit everything else.
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=no
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
