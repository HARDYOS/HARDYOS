[Unit]
Description=HardyOS control plane (API and web desktop)
Documentation=https://github.com/HARDYOS/HARDYOS
# On installed systems /var/lib/hardyos is a ZFS dataset (rpool/hardyos):
# start only after ZFS has mounted it, or the database would land underneath.
After=network-online.target hardyd-priv.service zfs-mount.service
Wants=network-online.target
Requires=hardyd-priv.service

[Service]
Type=simple
User=hardyd
Group=hardyd
ExecStart=/usr/bin/hardyd -https :443 -http :80 -web-root /usr/share/hardyos/web
StateDirectory=hardyos
StateDirectoryMode=0750
Restart=on-failure
RestartSec=2s
# Bind ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ReadWritePaths=-/run/hardyos

[Install]
WantedBy=multi-user.target
