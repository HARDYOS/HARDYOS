#!/bin/sh
# Shows the server's web address on the console login screen and keeps it
# current. agetty's own \4 escape falls back to the hostname's 127.0.1.1 when
# no address exists yet, which is useless from another computer.
#
#   hardyos-issue          write the address once
#   hardyos-issue --watch  write it, then rewrite it on every address change
#                          (run by hardyos-issue.service; works with any
#                          network setup: ifupdown, live-boot, DHCP renewals)
set -u
DIR=/etc/issue.d
OUT=$DIR/40-hardyos-address.issue

write() {
	addrs=$(ip -4 -o addr show scope global 2>/dev/null | awk '{ split($4, a, "/"); print a[1] }')
	mkdir -p "$DIR" || return 1
	tmp="$OUT.tmp"
	{
		if [ -n "$addrs" ]; then
			echo "  Open this address in a browser on another computer:"
			echo
			for a in $addrs; do
				echo "      https://$a"
			done
			echo
			echo "  Your browser will warn about the certificate the first time;"
			echo "  that is expected for a new server."
		else
			echo "  Waiting for a network address..."
			echo
			echo "  This screen updates when the server is on the network. If it"
			echo "  stays here, check the network cable and DHCP."
		fi
		echo
	} > "$tmp" || return 1
	# Only touch the file and redraw the prompt when something changed.
	if cmp -s "$tmp" "$OUT"; then
		rm -f "$tmp"
	else
		mv "$tmp" "$OUT"
		agetty --reload 2>/dev/null || true
	fi
}

write
if [ "${1:-}" = "--watch" ]; then
	ip -4 monitor address | while read -r _; do
		write
	done
fi
