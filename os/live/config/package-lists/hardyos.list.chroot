# Core system
systemd-sysv
dbus
sudo
ca-certificates
curl
jq
less
nano
openssh-server
chrony
locales
console-setup

# Storage: OpenZFS (built with DKMS against the image's kernel) and disk tools
dkms
zfs-dkms
zfsutils-linux
zfs-zed
# ZFS root support in the initramfs of installed systems
zfs-initramfs
smartmontools
nvme-cli
hdparm
lsscsi
gdisk
parted
dosfstools
# Shared folder permissions: setfacl/getfacl (POSIX ACLs for apps on shared folders)
acl

# Boot and install
efibootmgr
grub2-common
grub-efi-amd64-bin
grub-pc-bin
mmdebstrap
squashfs-tools
qrencode

# Hardware and network
pciutils
usbutils
ethtool
iproute2
nftables
ifupdown
ifenslave
vlan
isc-dhcp-client
iputils-arping
bind9-dnsutils

# Directory: Samba 4 AD domain controller (hardyos-dc.service) and the tools
# HardyOS uses to manage it
samba
samba-ad-dc
samba-ad-provision
samba-dsdb-modules
samba-vfs-modules
winbind
smbclient
krb5-user
ldb-tools

# File sharing: the host's own Samba (smbd + winbind, separate from the
# DC's) serves the shared folders over SMB as a domain member; winbind gives
# domain accounts Linux IDs (NSS) and, later, SFTP sign-in (PAM); Avahi
# advertises the server and Time Machine folders to Macs.
libnss-winbind
libpam-winbind
avahi-daemon

# File sharing: NFS server for shared folders shared over NFS. Kept off until
# a folder turns NFS on; hardyd-priv enables it then and writes
# /etc/exports.d/hardyos.exports.
nfs-kernel-server

# Apps: Docker Engine and Compose v2 for one-click apps (.hardyapp). The
# engine is started by hardyd-priv once the apps pool is mounted, with its
# data on that pool.
docker.io
docker-compose
# Debian 13 ships the docker command separately, and dockerd needs
# AppArmor's parser on Debian's kernel; both are only "recommended" by
# docker.io, and the image is built without recommends.
docker-cli
apparmor
xz-utils

# Virtual machines: QEMU/KVM through libvirt, driven by hardyd-priv only.
# UEFI firmware with Secure Boot (ovmf) and a virtual TPM (swtpm) for
# Windows 11; qemu-utils imports disk images; xorriso makes cloud-init
# seed discs; bridge-utils builds the bridge VMs share the home network
# through; dnsmasq-base serves libvirt's NAT network. qemu-system-x86 is
# this image's architecture (the Go and web code choose machine types and
# firmware at run time).
libvirt-daemon-system
libvirt-daemon-driver-qemu
libvirt-daemon-config-network
libvirt-clients
qemu-system-x86
qemu-utils
ovmf
swtpm
swtpm-tools
xorriso
bridge-utils
dnsmasq-base
iptables

# Live system
live-boot
live-config
live-config-systemd
